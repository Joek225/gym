<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Like Chrome, the browser app isn't in Apple's App Sandbox (downloaded apps then open
	     normally). Every web page still runs in WebKit's own locked-down page process.
	     With the hardened runtime, websites can use the camera and microphone only if you allow
	     them (per site, in the site info panel next to the address). -->
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
